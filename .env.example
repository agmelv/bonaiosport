# Port the addon server will listen on
PORT=7000

# Timezone used for kickoff times when a viewer has not chosen one in /configure
TZ=America/New_York

# Public address of this addon, if it is reached through a proxy or tunnel.
# Without it the addon guesses from the request, which is usually right.
# ADDON_URL=https://sports.example.com

# --- Sign-in ---------------------------------------------------------------
# Two separate keys, both optional. Leave one blank and that door stays open.
#
# AUTH_KEY protects the pages a person reads: the catalog at / and the
# configuration page. Visitors are sent to /login and land on the catalog.
AUTH_KEY=

# ADMIN_TOKEN protects the dashboard at /dashboard and everything that changes
# state, so somebody let in to browse cannot clear a cache. Setting this alone
# is enough to protect the dashboard.
ADMIN_TOKEN=

# NOTE: the addon's own endpoints -- manifest, catalogs, streams and artwork --
# are never behind either key. Nuvio and Stremio have no way to sign in, so
# gating them would stop the addon working. They serve fixtures and crests only.

# --- Performance -----------------------------------------------------------
# Catalog cards are rendered to JPEG once and cached. They are also rendered
# ahead of time, slowly, so opening a tab does not render hundreds at once.
# This is the pause between cards; raise it to make warming gentler still.
# WARM_GAP_MS=250

# --- Advanced ---------------------------------------------------------------
# How long a cached catalog may be served before a background refresh is
# started. Default 600000 (10 minutes).
# CATALOG_REVALIDATE_MS=600000

# Fetch providers one after another instead of together. Slower, but it keeps
# the peak memory down on a very small host.
# LOW_MEMORY_MODE=false

# Port the internal stream resolver listens on. Default 7003.
# RESOLVER_PORT=7003

# Interface to bind to. Default 0.0.0.0, which is every interface. Set to
# 127.0.0.1 to accept only local traffic, e.g. when a reverse proxy is in front.
# HOST=0.0.0.0

# Optional: Residential Proxy to bypass Cloudflare without Playwright
# Format: http://username:password@proxy-host.com:port
RESIDENTIAL_PROXY=

# TRUST_PROXY — only needed when a reverse proxy in front of the addon is on a
# public address. A hop count (TRUST_PROXY=1) or a comma-separated list of proxy
# addresses/CIDRs. Left unset, X-Forwarded-For is trusted only from loopback and
# private ranges, which is what a proxy on the same host already is.
# Never set this to "true" on a reachable box: it trusts the header from anyone,
# and with ADMIN_TOKEN unset that is enough to be treated as a local admin.
TRUST_PROXY=
